    "html": "<!doctype html>\n<html>\n<head>\n  <title>Synthetic completed slide example</title>\n  <style>\n    .slide { width:1280px; height:720px; font-family:Arial; font-size:18px; background:#ffffff; }\n    .title { color:#17365d; font-size:36px; font-weight:bold; }\n    .summary { font-size:20px; color:#444444; }\n    td { padding:6px; vertical-align:middle; }\n    th { padding:6px; vertical-align:middle; }\n  </style>\n</head>\n<body>\n  <section class=\"slide\" data-name=\"Regional overview\">\n    <h1 class=\"title\" style=\"left:40px;top:32px;width:1200px;height:65px\">Regional availability</h1>\n    <p class=\"summary\" style=\"left:40px;top:108px;width:1200px;height:55px\">Example portfolio: <b>three suppliers</b> across four regions</p>\n    <table data-name=\"Availability\" style=\"left:40px;top:190px;width:1200px;height:420px;\n                 font-size:17px;border:1px solid #17365d;border-collapse:collapse;table-layout:fixed\">\n      <colgroup>\n        <col style=\"width:14%\"><col style=\"width:10%\">\n        <col style=\"width:9.5%\"><col style=\"width:9.5%\">\n        <col style=\"width:9.5%\"><col style=\"width:9.5%\">\n        <col style=\"width:9.5%\"><col style=\"width:9.5%\">\n        <col style=\"width:9.5%\"><col style=\"width:9.5%\">\n      </colgroup>\n      <thead>\n        <tr style=\"height:60px;background:#0070c0;color:#ffffff;text-align:center\">\n          <th colspan=\"2\">Standard tier</th>\n          <th colspan=\"2\">Region A</th><th colspan=\"2\">Region B</th>\n          <th colspan=\"2\">Region C</th><th colspan=\"2\">Region D</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr style=\"background:#dce6f1\">\n          <td>Reference</td><td>Approved</td><td>Listed</td><td>$0.30</td><td>Listed</td><td>$0.32</td>\n          <td>Listed</td><td>$0.29</td><td>Pending</td><td>$0.31</td>\n        </tr>\n        <tr>\n          <td>Supplier A</td><td>Approved</td><td>Listed</td><td>$0.25</td><td>Listed</td><td>$0.26</td>\n          <td>Listed</td><td>$0.24</td><td>Listed</td><td>$0.25</td>\n        </tr>\n        <tr>\n          <td>Supplier B</td><td>Approved</td><td>Pending</td><td>$0.25</td><td>Listed</td><td>$0.26</td>\n          <td>Listed</td><td>$0.24</td><td>Pending</td><td>$0.25</td>\n        </tr>\n        <tr style=\"font-weight:bold\">\n          <td colspan=\"2\">Selling price</td><td colspan=\"2\">$0.25</td><td colspan=\"2\">$0.26</td><td colspan=\"2\">$0.24</td><td colspan=\"2\">$0.25</td>\n        </tr>\n        <tr style=\"font-weight:bold\">\n          <td colspan=\"2\">Listing price</td><td colspan=\"2\">$0.25</td><td colspan=\"2\">$0.26</td><td colspan=\"2\">$0.24</td><td colspan=\"2\">$0.25</td>\n        </tr>\n        <tr>\n          <td colspan=\"2\">Private</td><td colspan=\"2\">Available</td><td colspan=\"2\">Available</td><td colspan=\"2\">Available</td><td colspan=\"2\">Available</td>\n        </tr>\n        <tr>\n          <td colspan=\"2\">Public</td><td colspan=\"2\">Listed</td><td colspan=\"2\">Listed</td><td colspan=\"2\">Listed</td><td colspan=\"2\">Pending</td>\n        </tr>\n      </tbody>\n    </table>\n    <p style=\"left:40px;top:646px;width:1200px;height:40px;font-size:14px;color:#666666\">Synthetic data for connector demonstration</p>\n  </section>\n  <section class=\"slide\" data-name=\"Supplier sales\">\n    <h1 class=\"title\" style=\"left:40px;top:32px;width:1200px;height:65px\">Supplier sales</h1>\n    <p class=\"summary\" style=\"left:40px;top:108px;width:1200px;height:55px\">The table remains editable. The chart is an embedded SVG graphic.</p>\n    <table data-name=\"Sales\" style=\"left:40px;top:200px;width:530px;height:300px;\n                 font-size:20px;border:1px solid #17365d;padding:10px\">\n      <colgroup><col style=\"width:50%\"><col style=\"width:25%\"><col style=\"width:25%\"></colgroup>\n      <thead><tr style=\"background:#0070c0;color:#ffffff;height:60px\"><th>Supplier</th><th>Sales</th><th>Share</th></tr></thead>\n      <tbody>\n        <tr><td>Reference</td><td>$420k</td><td>42%</td></tr>\n        <tr><td>Supplier A</td><td>$350k</td><td>35%</td></tr>\n        <tr><td>Supplier B</td><td>$230k</td><td>23%</td></tr>\n      </tbody>\n    </table>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 580 360\" data-name=\"Sales chart\"\n         style=\"left:630px;top:190px;width:580px;height:360px\">\n      <rect x=\"0\" y=\"0\" width=\"580\" height=\"360\" fill=\"#ffffff\"/>\n      <line x1=\"70\" y1=\"290\" x2=\"550\" y2=\"290\" stroke=\"#777777\" stroke-width=\"2\"/>\n      <rect x=\"100\" y=\"80\" width=\"100\" height=\"210\" fill=\"#0070c0\"/>\n      <rect x=\"250\" y=\"115\" width=\"100\" height=\"175\" fill=\"#548235\"/>\n      <rect x=\"400\" y=\"175\" width=\"100\" height=\"115\" fill=\"#ed7d31\"/>\n      <text x=\"150\" y=\"60\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"22\" fill=\"#222222\">420</text>\n      <text x=\"300\" y=\"95\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"22\" fill=\"#222222\">350</text>\n      <text x=\"450\" y=\"155\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"22\" fill=\"#222222\">230</text>\n      <text x=\"150\" y=\"325\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"19\" fill=\"#222222\">Reference</text>\n      <text x=\"300\" y=\"325\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"19\" fill=\"#222222\">Supplier A</text>\n      <text x=\"450\" y=\"325\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"19\" fill=\"#222222\">Supplier B</text>\n    </svg>\n    <p style=\"left:40px;top:600px;width:1200px;height:60px;font-size:17px;white-space:pre-wrap\">Completed values arrive in the HTML.\nNo calculations or chart data bindings are required.</p>\n  </section>\n</body>\n</html>\n",
