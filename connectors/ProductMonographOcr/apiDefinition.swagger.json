{
  "swagger": "2.0",
  "info": {
    "title": "Product Monograph OCR",
    "description": "Extracts Markdown-compatible page chunks from Health Canada product-monograph PDFs, using the text layer when usable and bounded embedded OCR otherwise.",
    "version": "1.0.0"
  },
  "host": "api.example.com",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/monographs/ocr": {
      "post": {
        "summary": "Extract product monograph pages",
        "description": "Returns a continuation-aware batch of PDF page chunks. Usable text layers pass through; empty or unusable pages are OCR candidates.",
        "operationId": "ExtractProductMonographOcr",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/OcrRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "Page batch with per-page extraction and OCR status.",
            "schema": { "$ref": "#/definitions/OcrBatchResponse" }
          },
          "400": {
            "description": "Invalid JSON, PDF, encryption, or PDF structure.",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "413": {
            "description": "The decoded PDF exceeds 64 MiB.",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          },
          "500": {
            "description": "Unexpected processing failure.",
            "schema": { "$ref": "#/definitions/ErrorResponse" }
          }
        }
      }
    }
  },
  "definitions": {
    "OcrRequest": {
      "type": "object",
      "required": ["contentBytes"],
      "properties": {
        "contentBytes": {
          "type": "string",
          "format": "byte",
          "description": "PDF file content. Bind a file-content output directly; do not call base64().",
          "x-ms-summary": "PDF Content"
        },
        "fileName": {
          "type": "string",
          "maxLength": 1024,
          "description": "Optional source file name copied into page metadata.",
          "x-ms-summary": "File Name"
        },
        "startPage": {
          "type": "integer",
          "format": "int32",
          "default": 1,
          "minimum": 1,
          "maximum": 1000,
          "description": "One-based first page to process.",
          "x-ms-summary": "Start Page"
        },
        "maxPagesPerCall": {
          "type": "integer",
          "format": "int32",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum pages processed before returning continuation metadata.",
          "x-ms-summary": "Maximum Pages"
        },
        "languageHint": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "en", "fr"],
          "description": "Restricts OCR character prototypes when English is known; auto and French retain French characters.",
          "x-ms-summary": "Language Hint"
        },
        "minimumConfidence": {
          "type": "number",
          "format": "double",
          "default": 0.86,
          "minimum": 0.5,
          "maximum": 0.99,
          "description": "OCR text below this page confidence is suppressed.",
          "x-ms-summary": "Minimum Confidence",
          "x-ms-visibility": "advanced"
        },
        "maxOutputCharacters": {
          "type": "integer",
          "format": "int32",
          "default": 2097152,
          "minimum": 1000,
          "maximum": 6291456,
          "description": "Maximum UTF-16 characters returned across the page batch.",
          "x-ms-summary": "Maximum Output Characters",
          "x-ms-visibility": "advanced"
        }
      }
    },
    "OcrBatchResponse": {
      "type": "object",
      "properties": {
        "pageCount": { "type": "integer", "format": "int32", "description": "Total PDF page count." },
        "startPage": { "type": "integer", "format": "int32", "description": "Requested page at which this batch started." },
        "pagesReturned": { "type": "integer", "format": "int32", "description": "Number of page chunks returned." },
        "nextStartPage": { "type": "integer", "format": "int32", "x-nullable": true, "description": "Pass this value to startPage for the next batch; null when complete." },
        "hasMorePages": { "type": "boolean", "description": "True when another batch remains." },
        "deadlineReached": { "type": "boolean", "description": "True when the 100-second soft deadline stopped the batch." },
        "elapsedMilliseconds": { "type": "integer", "format": "int64", "description": "Connector processing time for the batch." },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/definitions/OcrPageChunk" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Document-level parser and recovery warnings."
        }
      }
    },
    "OcrPageChunk": {
      "type": "object",
      "properties": {
        "metadata": { "$ref": "#/definitions/PdfDocumentMetadata" },
        "page": { "$ref": "#/definitions/PdfPageGeometry" },
        "contentType": { "type": "string", "description": "Always text/markdown." },
        "text": { "type": "string", "description": "Text-layer Markdown or high-confidence OCR text; empty when OCR fails closed." },
        "characterCount": { "type": "integer", "format": "int32" },
        "tableCount": { "type": "integer", "format": "int32" },
        "usedTaggedStructure": { "type": "boolean" },
        "hasTextLayer": { "type": "boolean", "description": "Whether any text-layer content was present, even if unusable." },
        "truncated": { "type": "boolean" },
        "extractionMethod": {
          "type": "string",
          "enum": ["textLayer", "ocr", "none"],
          "description": "Source of returned text."
        },
        "ocrStatus": {
          "type": "string",
          "description": "notRequired, recognized, lowConfidence, unsupportedImageFilter, unsupportedPageComposition, noImage, codecUnavailable, imageDecodeFailed, classifierUnavailable, recognitionFailed, resourceLimit, or deadlineExceeded."
        },
        "confidence": { "type": "number", "format": "double", "description": "One for usable text layers; calibrated page score for OCR." },
        "sourceImage": { "$ref": "#/definitions/SourceImage" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SourceImage": {
      "type": "object",
      "x-nullable": true,
      "properties": {
        "filter": { "type": "string" },
        "width": { "type": "integer", "format": "int32" },
        "height": { "type": "integer", "format": "int32" },
        "dpi": { "type": "number", "format": "double" }
      }
    },
    "PdfDocumentMetadata": {
      "type": "object",
      "properties": {
        "format": { "type": "string" },
        "pdfVersion": { "type": "string" },
        "fileName": { "type": "string", "x-nullable": true },
        "fileSizeBytes": { "type": "integer", "format": "int32" },
        "title": { "type": "string", "x-nullable": true },
        "author": { "type": "string", "x-nullable": true },
        "subject": { "type": "string", "x-nullable": true },
        "keywords": { "type": "string", "x-nullable": true },
        "creator": { "type": "string", "x-nullable": true },
        "producer": { "type": "string", "x-nullable": true },
        "creationDate": { "type": "string", "x-nullable": true },
        "modificationDate": { "type": "string", "x-nullable": true },
        "trapped": { "type": "string", "x-nullable": true },
        "pageCount": { "type": "integer", "format": "int32" },
        "pageNumber": { "type": "integer", "format": "int32" }
      }
    },
    "PdfPageGeometry": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "format": "double" },
        "height": { "type": "number", "format": "double" },
        "rotation": { "type": "integer", "format": "int32" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": { "$ref": "#/definitions/ErrorDetail" }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
