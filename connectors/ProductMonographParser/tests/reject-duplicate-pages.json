{
  "name": "ParseProductMonograph rejects duplicate page numbers",
  "description": "Strictly ascending unique page numbers are part of the page-array contract.",
  "includeInAutomatedRun": true,
  "operationId": "ParseProductMonograph",
  "method": "POST",
  "relativePath": "/monographs/parse",
  "requestBody": {
    "pages": [
      {
        "pageNumber": 1,
        "pageCount": 2,
        "contentType": "text/markdown",
        "text": "PRODUCT MONOGRAPH"
      },
      {
        "pageNumber": 1,
        "pageCount": 2,
        "contentType": "text/markdown",
        "text": "Duplicate"
      }
    ]
  },
  "expected": {
    "statusCode": 400,
    "bodyJson": {
      "error": {
        "code": "INVALID_PAGES",
        "message": "Page numbers must be strictly ascending and unique.",
        "details": {
          "index": 1,
          "pageNumber": 1,
          "previousPageNumber": 1
        }
      }
    },
    "outboundRequestCount": 0
  }
}
