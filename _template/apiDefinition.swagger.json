{
  "swagger": "2.0",
  "info": {
    "title": "Connector Name",
    "description": "Description of what this connector does. Must not mention Power Platform products.",
    "version": "1.0.0",
    "contact": {
      "name": "Your Name",
      "email": "your.email@example.com"
    }
  },
  "host": "api.example.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/items": {
      "get": {
        "operationId": "GetItems",
        "summary": "Get all items",
        "description": "Retrieves a list of all available items from the API.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "required": false,
            "default": 10,
            "description": "Maximum number of items to return.",
            "x-ms-summary": "Limit"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "required": false,
            "default": 0,
            "description": "Number of items to skip.",
            "x-ms-summary": "Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved items.",
            "schema": {
              "$ref": "#/definitions/ItemListResponse"
            }
          },
          "400": {
            "description": "Bad request. Invalid parameters."
          },
          "401": {
            "description": "Unauthorized. Authentication required."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/items/{id}": {
      "get": {
        "operationId": "GetItemById",
        "summary": "Get item by ID",
        "description": "Retrieves a specific item by its unique identifier.",
        "parameters": [
          {
            "$ref": "#/parameters/ItemIdInPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved item.",
            "schema": {
              "$ref": "#/definitions/Item"
            }
          },
          "404": {
            "description": "Item not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "operationId": "CreateItem",
        "summary": "Create new item",
        "description": "Creates a new item with the provided data.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Item data to create.",
            "schema": {
              "$ref": "#/definitions/CreateItemRequest"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Item created successfully.",
            "schema": {
              "$ref": "#/definitions/Item"
            }
          },
          "400": {
            "description": "Bad request. Invalid item data."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "operationId": "DeleteItem",
        "summary": "Delete item",
        "description": "Deletes an item by its unique identifier.",
        "parameters": [
          {
            "$ref": "#/parameters/ItemIdInPath"
          }
        ],
        "responses": {
          "204": {
            "description": "Item deleted successfully."
          },
          "404": {
            "description": "Item not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "parameters": {
    "ItemIdInPath": {
      "name": "id",
      "in": "path",
      "type": "string",
      "required": true,
      "description": "Unique identifier of the item.",
      "x-ms-summary": "Item ID",
      "x-ms-url-encoding": "single"
    }
  },
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the item.",
          "x-ms-summary": "ID"
        },
        "name": {
          "type": "string",
          "description": "Name of the item.",
          "x-ms-summary": "Name"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the item.",
          "x-ms-summary": "Description"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the item was created.",
          "x-ms-summary": "Created At"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the item was last updated.",
          "x-ms-summary": "Updated At"
        }
      }
    },
    "ItemListResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "List of items.",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "total": {
          "type": "integer",
          "description": "Total number of items available.",
          "x-ms-summary": "Total Count"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum items per page.",
          "x-ms-summary": "Limit"
        },
        "offset": {
          "type": "integer",
          "description": "Current offset.",
          "x-ms-summary": "Offset"
        }
      }
    },
    "CreateItemRequest": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the item to create.",
          "x-ms-summary": "Name"
        },
        "description": {
          "type": "string",
          "description": "Optional description for the item.",
          "x-ms-summary": "Description"
        }
      }
    }
  }
}
